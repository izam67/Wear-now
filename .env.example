# Wear Now — environment variables
# Copy this file to .env for local development; .env is gitignored.
#
# Production values go into the hosting platform's environment settings
# (Vercel for the app, Turso for the database) so they never reach a repo.

# --- Sessions -------------------------------------------------------------
# Used to sign the session cookie. Any long random string works, but it MUST be
# stable across restarts or everyone is logged out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Database -------------------------------------------------------------
# Local development uses an embedded SQLite file; this is also what the project
# falls back to if DATABASE_URL is unset, so you do not need to set it locally.
DATABASE_URL=file:./data/wearnow.db

# Production (Turso) — uncomment and set these on Vercel:
# DATABASE_URL=libsql://<database>.<org>.turso.io
# DATABASE_AUTH_TOKEN=<turso auth token>

# --- Optional -------------------------------------------------------------
# Base URL used by scripts/probe-routes.mts when not hitting localhost.
# BASE_URL=http://localhost:3000